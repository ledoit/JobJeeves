{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jobjeeves.vercel.app" }],
      "destination": "https://jobjeeves.menhir-holdings.com/:path*",
      "permanent": true
    }
  ]
}
