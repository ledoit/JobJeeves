# Choose: groq (default) or openai
LLM_PROVIDER=groq

# Groq (recommended if you want to avoid OpenAI quota issues)
GROQ_API_KEY=YOUR_API_KEY
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (optional)
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_MODEL=gpt-4o-mini

# Optional
CORS_ORIGINS=http://localhost:5173

# Local Vite dev — backend URL for proxy (Docker Compose / manual uvicorn)
VITE_API_BASE_URL=http://localhost:8000

# Vercel production frontend — full API origin (see README-vercel.md)
# VITE_API_URL=https://your-api.example.com

