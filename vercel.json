{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cp -r backend api/backend && cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "jobjeeves.vercel.app" }],
      "destination": "https://jobjeeves.menhir-holdings.com/:path*",
      "permanent": true
    }
  ]
}
